# ==============================================================
#  NEXORA SERVER ENVIRONMENT VARIABLES
#  1. Copy this file:  cp server/.env.example server/.env
#  2. Fill in the values below.
# ==============================================================

# --------------------------------------------------------------
# REQUIRED — Your MongoDB Atlas connection string.
# This is the ONLY place you need to add your credentials.
# Atlas → Cluster → Connect → Drivers → copy the URI, then:
#   - replace <password> with your real database password
#   - keep the database name at the end (e.g. /nexora)
# --------------------------------------------------------------
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING_HERE

# --------------------------------------------------------------
# Server settings
# --------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Where the React app runs in development (used for CORS).
# In production, set this to your frontend origin, e.g.
# CLIENT_ORIGIN=https://your-frontend.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# --------------------------------------------------------------
# Auth secrets — generate long random strings, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# --------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_DAYS=7

# --------------------------------------------------------------
# Initial admin account — used by "npm run seed" (optional).
# The seed script creates this account if it does not exist yet.
# Change these before running the seed!
# --------------------------------------------------------------
ADMIN_NAME=Nexora Admin
ADMIN_EMAIL=admin@nexora.gg
ADMIN_PASSWORD=choose_a_strong_admin_password
