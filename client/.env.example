# ==============================================================
#  NEXORA CLIENT ENVIRONMENT VARIABLES
#  Optional. Only needed when frontend & backend are deployed to
#  DIFFERENT domains (e.g. Vercel frontend + Render backend).
#  For local development and same-domain deploys, leave unset —
#  the app talks to the backend via a relative /api path.
#
#  Example (split deployment):
#  VITE_API_URL=https://your-api-host.example.com
# ==============================================================
VITE_API_URL=
